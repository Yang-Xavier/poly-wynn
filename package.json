{
  "name": "poly-wynn",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "src/app/web-client"
  ],
  "scripts": {
    "prod:stop": "pm2 kill",
    "prod:start": "npm run web:client:build && node ./scripts/pm2-start.js",
    "syncConfig": "bun ./scripts/sync-config.ts",
    "crypto15min:runPolyWynn": "bun src/boostApp.ts crypto15min:runPolyWynn",
    "crypto15min:redeem": "bun src/boostApp.ts crypto15min:redeem",
    "crypto15min:debug": "bun src/boostApp.ts crypto15min:debug",
    "web:dev": "concurrently -n \"server,client\" -c \"blue,green\" --prefix \"[{name}]\" --kill-others-on-fail \"npm run web:server\" \"npm run web:client:dev\"",
    "web:server": "bun src/app/web-server/index.ts",
    "web:server:prod": "NODE_ENV=production bun src/app/web-server/index.ts",
    "web:client:dev": "npm run dev --workspace=poly-wynn-web-client",
    "web:client:build": "npm run build --workspace=poly-wynn-web-client",
    "web:client:install": "npm install --workspace=poly-wynn-web-client",
    "spreadArbitrage:start": "ENABLE_CONSOLE=true bun src/app/spreadArbitrage/index.ts",
    "format": "prettier --write \"src/**/*.{ts,js,json}\"",
    "deploy": "bash ./scripts/deploy.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@ethersproject/contracts": "^5.8.0",
    "@ethersproject/providers": "^5.8.0",
    "@ethersproject/units": "^5.8.0",
    "@ethersproject/wallet": "^5.8.0",
    "@koa/cors": "^5.0.0",
    "@koa/router": "^12.0.1",
    "@polymarket/builder-relayer-client": "^0.0.8",
    "@polymarket/clob-client": "^5.1.3",
    "axios": "^1.7.7",
    "bun": "^1.3.5",
    "co": "^4.6.0",
    "danfojs": "^1.2.0",
    "express": "^4.18.2",
    "json5": "^2.2.3",
    "koa": "^2.15.0",
    "koa-bodyparser": "^4.4.1",
    "koa-static": "^5.0.0",
    "type-fest": "^4.31.0",
    "viem": "^2.40.3",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.25.7",
    "@babel/core": "^7.25.7",
    "@babel/node": "^7.25.7",
    "@babel/preset-env": "^7.25.7",
    "@types/express": "^4.17.21",
    "@types/koa": "^2.14.0",
    "@types/koa-bodyparser": "^4.3.12",
    "@types/koa-static": "^4.0.4",
    "@types/node": "^22.7.4",
    "@types/ws": "^8.18.1",
    "@zerollup/ts-transform-paths": "^1.7.18",
    "concurrently": "^9.2.1",
    "esbuild": "^0.24.0",
    "esbuild-plugin-alias": "^0.2.1",
    "husky": "^9.1.7",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.2"
  }
}
